{
  "kind": "scanner", "version": "0.1.0",
  "bloxsmith_compatibility": ["1.0.9"], "tested_with_bloxsmith": "1.0.9",
  "title": "Scanner", "description": "Scans with an installed SANE device and publishes a complete PDF file.",
  "locales": {"en": "locales/en.json", "fr": "locales/fr.json"},
